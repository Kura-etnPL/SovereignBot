{
    "name": "sovereignbot-desktop",
    "version": "1.1.0-dev",
    "description": "SovereignBot Windows desktop application: local-first AI coworker runtime with governed computer access.",
    "productName": "SovereignBot",
    "type": "module",
    "private": true,
    "license": "MIT",
    "main": "src/main/index.js",
    "scripts": {
        "sync-core": "node scripts/sync-core.mjs",
        "fetch-node": "node scripts/fetch-node.mjs",
        "check": "node scripts/check.mjs",
        "test": "node --test",
        "package": "npm run sync-core && electron-forge package",
        "start": "electron .",
        "smoke:packaged": "node scripts/run-packaged-smoke.mjs",
        "verify-fuses": "node scripts/apply-and-verify-fuses.mjs --verify-only",
        "secret-scan": "node scripts/no-secret-scan.mjs",
        "make": "npm run sync-core && electron-forge make --platform win32 --arch x64",
        "installer-e2e": "node scripts/installer-e2e.mjs",
        "release-manifest": "node scripts/write-release-manifest.mjs"
    },
    "devDependencies": {
        "@electron-forge/cli": "7.11.2",
        "@electron-forge/maker-squirrel": "7.11.2",
        "@electron/fuses": "2.1.3",
        "electron": "43.4.1"
    }
}
