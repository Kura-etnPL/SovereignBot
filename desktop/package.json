        "verify:p24-artifacts": "node scripts/verify-p24-artifacts.mjs",
        "verify:p25-memory-editor": "node scripts/verify-p25-memory-editor.mjs",
        "verify:p26-artifact-export": "node scripts/verify-p26-artifact-export.mjs",
        "verify:p27-artifact-retention": "node scripts/verify-p27-artifact-retention.mjs",
        "verify:p28-project-create": "node scripts/verify-p28-project-create.mjs",
    "verify:p29-routine-selector": "node scripts/verify-p29-routine-selector.mjs",
    "verify:p30-routine-actions": "node scripts/verify-p30-routine-actions.mjs",
    "verify:p31-team-pack-gallery": "node scripts/verify-p31-team-pack-gallery.mjs",
