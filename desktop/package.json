        "verify:p33-search-palette": "node scripts/verify-p33-search-palette.mjs",
        "verify:p34-projects": "node scripts/verify-p34-projects.mjs",
        "verify:p35-this-pc": "node scripts/verify-p35-this-pc-deep-links.mjs",
        "verify:p36-first-run": "node scripts/verify-p36-first-run.mjs",
        "verify:p37-settings": "node scripts/verify-p37-settings.mjs",
        "verify:p38-search-relevance": "node scripts/verify-p38-search-relevance.mjs",
        "verify:p39-conversation-pagination": "node scripts/verify-p39-conversation-pagination.mjs",
        "verify:p40-memory-relevance": "node scripts/verify-p40-memory-relevance.mjs",
        "verify:p42-artifact-index": "node scripts/verify-p42-artifact-index.mjs",
        "verify:p43-search-index": "node scripts/verify-p43-search-index.mjs",
        "verify:p44-conversation-search": "node scripts/verify-p44-conversation-search.mjs",
        "verify:p45-artifact-search": "node scripts/verify-p45-artifact-search.mjs",
        "verify:p46-trigger-workspace-label": "node scripts/verify-v44-event-triggers.mjs",
