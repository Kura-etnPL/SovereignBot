        "verify:p14-team-fanout": "node scripts/verify-p14-team-fanout.mjs",
        "verify:p15-project-command-center": "node scripts/verify-p15-project-command-center.mjs",
        "verify:p16-team-activity": "node scripts/verify-p16-team-activity.mjs",
        "verify:p17-notification-center": "node scripts/verify-p17-notification-center.mjs",
        "verify:p18-channel-unread": "node scripts/verify-p18-channel-unread.mjs",
