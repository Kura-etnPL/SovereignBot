{
    "name": "sovereignbot-desktop",
    "version": "4.0.0",
    "description": "SovereignBot Windows desktop application: local-first AI coworker runtime with governed computer access.",
    "productName": "SovereignBot",
    "type": "module",
    "private": true,
    "license": "MIT",
    "main": "src/main/index.js",
    "scripts": {
        "sync-core": "node scripts/sync-core.mjs",
        "fetch-node": "node scripts/fetch-node.mjs",
        "prepare-runtime": "node scripts/sync-core.mjs && node scripts/fetch-node.mjs",
        "check": "node scripts/check.mjs",
        "test": "node --test",
        "package": "npm run prepare-runtime && node scripts/run-forge-with-internal-node.mjs package",
        "start": "npm run prepare-runtime && electron .",
        "smoke:packaged": "node scripts/run-packaged-smoke.mjs",
        "dogfood:packaged": "node scripts/run-packaged-dogfood.mjs",
        "verify:software-team": "node scripts/verify-software-team.mjs",
        "verify:p13-team-collaboration": "node scripts/verify-p13-team-collaboration.mjs",
        "verify:p14-team-fanout": "node scripts/verify-p14-team-fanout.mjs",
        "verify:p15-project-command-center": "node scripts/verify-p15-project-command-center.mjs",
        "verify:p16-team-activity": "node scripts/verify-p16-team-activity.mjs",
        "verify-fuses": "node scripts/apply-and-verify-fuses.mjs --verify-only",
        "secret-scan": "node scripts/no-secret-scan.mjs",
        "make": "npm run prepare-runtime && node scripts/run-forge-with-internal-node.mjs make --platform win32 --arch x64",
        "installer-e2e": "node scripts/installer-e2e.mjs",
        "release-manifest": "node scripts/write-release-manifest.mjs",
        "release-version": "node scripts/check-release-version.mjs"
    },
    "devDependencies": {
        "@electron-forge/cli": "7.11.2",
        "@electron-forge/maker-squirrel": "7.11.2",
        "@electron/fuses": "2.1.3",
        "electron": "43.4.1"
    }
}
